<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".SearchActivity"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/panel_header_height"
        app:navigationIcon="@drawable/ic_arrow_back_full_24"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/search"
        app:titleTextAppearance="@style/TextAppearance.PlaylistMaker.Toolbar"
        app:titleTextColor="?attr/colorOnSurface"
        app:contentInsetStartWithNavigation="@dimen/content_inset_compact" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginStart="@dimen/button_spacing"
        android:layout_marginEnd="@dimen/button_spacing"
        android:layout_marginTop="@dimen/icon_padding">

        <EditText
            android:id="@+id/inputEditText"
            style="@style/Widget.PlaylistMaker.SearchField"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/search"
            android:autofillHints="@string/search"
            android:imeOptions="actionDone"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/icon_padding"
            android:src="@drawable/ic_close_16"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/icon_padding">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/placeholder_top_margin"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:visibility="gone">

            <ImageView
                android:id="@+id/placeholderImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/placeholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/placeholder_text_spacing"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PlaylistMaker.Placeholder"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refreshButton"
                style="@style/Widget.PlaylistMaker.RefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/refresh_button_top_margin"
                android:text="@string/refresh"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
