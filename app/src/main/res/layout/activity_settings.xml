<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/panel_header_height"
        app:navigationIcon="@drawable/ic_arrow_back_full_24"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/settings"
        app:titleTextAppearance="@style/TextAppearance.PlaylistMaker.Toolbar"
        app:titleTextColor="?attr/colorOnSurface"
        app:contentInsetStartWithNavigation="12dp" />

    <LinearLayout
        style="@style/Widget.PlaylistMaker.MenuItem"
        android:layout_marginTop="@dimen/content_top_margin" >

        <TextView
            style="@style/Widget.PlaylistMaker.MenuItem.Label"
            android:text="@string/theme_dark" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.PlaylistMaker.MenuItem" >

        <TextView
            style="@style/Widget.PlaylistMaker.MenuItem.Label"
            android:text="@string/share" />

        <ImageView
            style="@style/Widget.PlaylistMaker.MenuItem.Icon"
            android:src="@drawable/ic_share_24" />
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.PlaylistMaker.MenuItem" >

        <TextView
            style="@style/Widget.PlaylistMaker.MenuItem.Label"
            android:text="@string/support" />

        <ImageView
            style="@style/Widget.PlaylistMaker.MenuItem.Icon"
            android:src="@drawable/ic_support_24" />
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.PlaylistMaker.MenuItem" >

        <TextView
            style="@style/Widget.PlaylistMaker.MenuItem.Label"
            android:text="@string/user_agreement" />

        <ImageView
            style="@style/Widget.PlaylistMaker.MenuItem.Icon"
            android:src="@drawable/ic_arrow_forward_24" />
    </LinearLayout>

</LinearLayout>
