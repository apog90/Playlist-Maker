<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_blue"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/panel_header_height"
        app:contentInsetStart="@dimen/screen_horizontal_margin"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.PlaylistMaker.Toolbar"
        app:titleTextColor="@color/white" />

    <Button
        android:id="@+id/search_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:layout_marginTop="@dimen/content_top_margin"
        android:layout_marginBottom="@dimen/button_spacing"
        android:textColor="@color/black"
        android:text="@string/search"
        android:textSize="@dimen/text_size_large"
        android:lineHeight="@dimen/text_size_large"
        android:fontFamily="@font/ys_display_medium"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_search_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/icon_padding"
        app:iconTint="@color/black" />

    <Button
        android:id="@+id/media_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:layout_marginBottom="@dimen/button_spacing"
        android:textColor="@color/black"
        android:text="@string/media"
        android:textSize="@dimen/text_size_large"
        android:lineHeight="@dimen/text_size_large"
        android:fontFamily="@font/ys_display_medium"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_media_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/icon_padding"
        app:iconTint="@color/black" />

    <Button
        android:id="@+id/settings_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:layout_marginBottom="28dp"
        android:textColor="@color/black"
        android:text="@string/settings"
        android:textSize="@dimen/text_size_large"
        android:lineHeight="@dimen/text_size_large"
        android:fontFamily="@font/ys_display_medium"
        android:textAllCaps="false"
        android:letterSpacing="0"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/ic_settings_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/icon_padding"
        app:iconTint="@color/black" />

</LinearLayout>
